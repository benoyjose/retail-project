{
  "info": {
    "name": "Retail Microservices System - E2E API Suite",
    "description": "Comprehensive End-to-End API collection testing all 10 Retail domain use cases through Spring Cloud API Gateway (Port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Authentication & Security (NFR 5.3)",
      "item": [
        {
          "name": "Customer Registration (UC-1)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.morgan@retaildomain.com\",\n  \"password\": \"SecureRetail2026!\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"phone\": \"+1-555-019-2834\",\n  \"shippingAddress\": \"742 Evergreen Terrace, Springfield, OR 97477\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "register"]
            }
          }
        },
        {
          "name": "Customer Login (15m JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.environment.set('accessToken', jsonData.data.accessToken);",
                  "    pm.environment.set('refreshToken', jsonData.data.refreshToken);",
                  "    pm.environment.set('customerId', jsonData.data.customer.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.morgan@retaildomain.com\",\n  \"password\": \"SecureRetail2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Use Case 1: Customer Profile",
      "item": [
        {
          "name": "Get Customer Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Use Case 2: Product Search & Browsing",
      "item": [
        {
          "name": "Search Products with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?keyword=laptop&minRating=4.0&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "keyword", "value": "laptop" },
                { "key": "minRating", "value": "4.0" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
